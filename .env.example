APP_NAME="PT. Panca Bima Bergawa"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://bimabergawa.test

# Multi-Domain Subdomain Configuration
# Local Development (Laragon): bimabergawa.test (Public) & app.bimabergawa.test (ERP)
# Production: bimabergawa.com (Public) & app.bimabergawa.com (ERP)
APP_DOMAIN_PUBLIC=bimabergawa.test
APP_DOMAIN_ERP=app.bimabergawa.test

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration (MySQL 8.0 InnoDB)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bimabergawa
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.bimabergawa.test

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
FILESYSTEM_PRIVATE_DISK=local_private
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=pbb_cache_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@bimabergawa.com"
MAIL_FROM_NAME="${APP_NAME}"

# Passwordless OTP Settings (AGENTS.md Constraint 3.4)
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=3

# Commercial HPP & VAT Settings (AGENTS.md Constraint 3.5 & 3.6)
CRITICAL_MARGIN_THRESHOLD=8.00
WARNING_MARGIN_THRESHOLD=15.00
STATIC_VAT_RATE=11.00
DIRECTOR_APPROVAL_LIMIT=100000000

# WhatsApp Telemetry Hotline
WHATSAPP_HOTLINE_NUMBER="6281112345678"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
