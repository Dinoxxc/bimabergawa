<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|php8|phar|sh|pl|cgi|asp|aspx)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

Options -Indexes -ExecCGI

<IfModule mod_php.c>
    php_flag engine off
</IfModule>

<IfModule mod_mime.c>
    RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
</IfModule>
